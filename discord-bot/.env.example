# --- Discord ---
# From the Discord Developer Portal → your application.
DISCORD_BOT_TOKEN=          # Bot → Token (secret; prefer Infisical in prod)
DISCORD_CLIENT_ID=          # OAuth2 → Client ID (application id)
DISCORD_GUILD_ID=           # your server id (right-click server → Copy Server ID)

# Channel ids (right-click channel → Copy Channel ID; Developer Mode must be on).
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_INCIDENTS_CHANNEL_ID=
DISCORD_APPROVALS_CHANNEL_ID=
DISCORD_TICKETS_CHANNEL_ID=
# The PA (Hermes Brain) conversation channel. Any message here routes to the PA
# via /api/bot/pa/chat. The PA also answers DMs and @mentions anywhere. Optional —
# leave blank to use DM/@mention only. (Requires HERMES_BRAIN_ENABLED=1 on Sentinel.)
DISCORD_PA_CHANNEL_ID=

# --- Sentinel ---
SENTINEL_API_BASE=https://ops.scribuo.com
OPS_BOT_TOKEN=              # must match Sentinel's OPS_BOT_TOKEN (secret; Infisical in prod)

# --- Poller ---
POLL_INTERVAL_MS=15000

# --- Infisical (optional; if set, DISCORD_BOT_TOKEN + OPS_BOT_TOKEN resolve from here) ---
# INFISICAL_SITE_URL=https://secrets.bentech.dev
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=prod
