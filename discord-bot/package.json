{
  "name": "sentinel-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discord bot — a second interface onto the Sentinel ops console + Hermes agents. Thin client over Sentinel's /api/bot/* surface.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "register": "tsx src/register.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
