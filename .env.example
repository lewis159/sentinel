# Sentinel — environment template. Copy to .env.local for dev; inject as secrets in prod.
# (The UI prototype needs NONE of these yet — they're the Phase-2 functionality wiring.)

# --- Supabase (ops schema) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk auth (shared estate instance with YT; cookie scoped to .bentech.dev) ---
# Authorization: Phase 0 gates everything behind Clerk publicMetadata.role === 'global_admin'.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- Docker socket-proxy (read-only for snapshots) ---
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# --- Hermes (self-hosted AI) ---
# HERMES_URL=

# --- Hermes Brain (P0 — LangGraph agent behind /api/hermes/*) ---
# Master switch. Everything the Brain adds is behind this flag; unset = existing
# app is completely unaffected. Set to 1/true to enable /api/hermes/pa/chat and the
# resume-and-execute (gated tool) path.
# HERMES_BRAIN_ENABLED=1
# Optional per-persona model override for the PA (defaults to the configured model).
# HERMES_PA_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter key + model are resolved by lib/hermes/config.ts (Infisical → env → DB):
# OPENROUTER_API_KEY=
# HERMES_MODEL=anthropic/claude-3.5-sonnet
# Brain checkpoints live in a dedicated `hermes` schema on DATABASE_URL (below).

# --- PA watchdog tools ---
# broadcastStatus posts to #pa-status via this Discord webhook (else it logs a TODO).
# DISCORD_PA_STATUS_WEBHOOK=
# getDeployStatus reads GitHub Actions + open PRs for these repos (needs a token).
# GITHUB_TOKEN=
# ESTATE_REPOS=owner/repo,owner/repo2

# --- Webhook-in ingest (HMAC) ---
# OPS_INGEST_SECRET=

# --- Discord bot surface (token/HMAC, /api/bot/*) ---
# Dedicated least-privilege token the Discord bot presents to /api/bot/*.
# Store in Infisical in prod. Rotate to disable the bot without touching ingest.
# OPS_BOT_TOKEN=
#
# PA surface + watchdog (both token-gated with OPS_BOT_TOKEN, behind HERMES_BRAIN_ENABLED):
#   POST /api/bot/pa/chat       — the bot relays Discord PA messages here.
#   POST /api/bot/watchdog/tick — one CI/PR health sweep → posts to #pa-status on
#     failure/stale-PR. Sentinel has no in-process scheduler, so drive it with an
#     EXTERNAL cron (systemd timer / Portainer / GH Actions schedule / cron-job.org):
#       */15 * * * *  curl -fsS -X POST -H "x-ingest-token: $OPS_BOT_TOKEN" \
#         https://ops.scribuo.com/api/bot/watchdog/tick
#     Idempotent: it only re-posts when the failing set changes (POST {"force":true} to override).

# --- Notification channels ---
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
