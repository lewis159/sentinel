# Sentinel — environment template. Copy to .env.local for dev; inject as secrets in prod.
# (The UI prototype needs NONE of these yet — they're the Phase-2 functionality wiring.)

# --- Supabase (ops schema) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk auth (shared estate instance with YT; cookie scoped to .bentech.dev) ---
# Authorization: Phase 0 gates everything behind Clerk publicMetadata.role === 'global_admin'.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/

# --- Docker socket-proxy (read-only for snapshots) ---
# DOCKER_HOST=tcp://docker-socket-proxy:2375

# --- Hermes (self-hosted AI) ---
# HERMES_URL=

# --- Hermes Brain (P0 — LangGraph agent behind /api/hermes/*) ---
# Master switch. Everything the Brain adds is behind this flag; unset = existing
# app is completely unaffected. Set to 1/true to enable /api/hermes/pa/chat and the
# resume-and-execute (gated tool) path.
# HERMES_BRAIN_ENABLED=1
# Optional per-persona model override for the PA (defaults to the configured model).
# HERMES_PA_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter key + model are resolved by lib/hermes/config.ts (Infisical → env → DB):
# OPENROUTER_API_KEY=
# HERMES_MODEL=anthropic/claude-3.5-sonnet
# Brain checkpoints live in a dedicated `hermes` schema on DATABASE_URL (below).

# --- Hermes KB semantic retrieval (pgvector) ---
# Sub-flag: turn the hardcoded lexical KB snippets into REAL pgvector semantic
# retrieval (embeds content/kb/*.md + resolved tickets into hermes.kb_chunks).
# OFF/unset = existing lexical snippet retrieval (app completely unaffected).
# Independent of HERMES_BRAIN_ENABLED (the KB is used by the department agents on
# the non-Brain /api/bot/triage path too).
# HERMES_KB_PGVECTOR=1
#
# DB PREREQUISITE: the pgvector extension must be installed on the Postgres
# cluster. db/init/13_hermes_kb.sql runs `create extension if not exists vector`
# (works during first-container-init as superuser). On the live ytdb/Patroni
# cluster the migrator role may lack CREATE EXTENSION — if so, run once as a
# superuser:  CREATE EXTENSION IF NOT EXISTS vector;  (image must ship pgvector).
#
# Embedding model + endpoint (OpenAI-compatible /embeddings). Defaults reuse the
# OpenRouter key above. text-embedding-3-small = 1536 dims and MUST match the
# vector(1536) column in db/init/13_hermes_kb.sql — change both together.
# HERMES_EMBEDDINGS_MODEL=text-embedding-3-small
# HERMES_EMBEDDINGS_URL=https://openrouter.ai/api/v1/embeddings
# Optional: point embeddings straight at OpenAI (or any OpenAI-compatible server)
# with a separate key if your OpenRouter account lacks embeddings coverage.
# HERMES_EMBEDDINGS_API_KEY=
#
# Populate/refresh the store with an EXTERNAL cron hitting the token-gated route:
#   */30 * * * *  curl -fsS -X POST -H "x-ingest-token: $OPS_BOT_TOKEN" \
#     https://ops.scribuo.com/api/bot/kb/reindex
# Idempotent: unchanged chunks are skipped (never re-embedded), stale ones pruned.

# --- PA watchdog tools ---
# broadcastStatus posts to #pa-status via this Discord webhook (else it logs a TODO).
# DISCORD_PA_STATUS_WEBHOOK=
# getDeployStatus reads GitHub Actions + open PRs for these repos (needs a token).
# GITHUB_TOKEN=
# ESTATE_REPOS=owner/repo,owner/repo2

# --- Webhook-in ingest (HMAC) ---
# OPS_INGEST_SECRET=

# --- Discord bot surface (token/HMAC, /api/bot/*) ---
# Dedicated least-privilege token the Discord bot presents to /api/bot/*.
# Store in Infisical in prod. Rotate to disable the bot without touching ingest.
# OPS_BOT_TOKEN=
#
# PA surface + watchdog (both token-gated with OPS_BOT_TOKEN, behind HERMES_BRAIN_ENABLED):
#   POST /api/bot/pa/chat       — the bot relays Discord PA messages here.
#   POST /api/bot/watchdog/tick — one CI/PR health sweep → posts to #pa-status on
#     failure/stale-PR. Sentinel has no in-process scheduler, so drive it with an
#     EXTERNAL cron (systemd timer / Portainer / GH Actions schedule / cron-job.org):
#       */15 * * * *  curl -fsS -X POST -H "x-ingest-token: $OPS_BOT_TOKEN" \
#         https://ops.scribuo.com/api/bot/watchdog/tick
#     Idempotent: it only re-posts when the failing set changes (POST {"force":true} to override).

# --- P2 customer intake (support-chat widget + email-to-ticket) ---
# Master switch. Everything the P2 intake adds is behind this flag; unset/OFF =
# the public chat + email routes short-circuit to a disabled response and nothing
# new is reachable (shipped app unaffected). Independent of HERMES_BRAIN_ENABLED.
# HERMES_INTAKE_ENABLED=1
#
# Least-privilege token that ships in the public support-chat widget (data-token).
# It ONLY authorizes /api/public/support/* (open/continue a support conversation).
# Browser-visible by design; rotate to disable the widget without touching ingest.
# OPS_SUPPORT_TOKEN=
#
# Server-only token the Cloudflare Email Routing worker / provider webhook presents
# to /api/ingest/email (token OR HMAC). NEVER placed in a browser. OPS_INGEST_SECRET
# is also accepted by this route for signed server-to-server callers.
# OPS_EMAIL_TOKEN=
#
# Optional: absolute base used to deep-link L0 KB results back to the live KB
# (defaults to relative /v2/kb/<slug>). e.g. https://ops.scribuo.com
# SUPPORT_KB_PUBLIC_BASE=

# --- Notification channels ---
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
